# For running the backend directly (uvicorn) — copy to backend/.env.
# docker compose does NOT read this file; it uses the root .env (see ../.env.example).

# Required: the app refuses to start without DATABASE_URL and GROQ_API_KEY.
DATABASE_URL=postgresql+asyncpg://hcp_user:<password>@127.0.0.1:5432/hcp_crm

# Groq API (create a free key at https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=gemma2-9b-it
GROQ_FALLBACK_MODEL=llama-3.3-70b-versatile

# CORS
FRONTEND_ORIGIN=http://localhost:5173
