# The only env file: copy to .env (git-ignored) and fill in.
# Read by `docker compose` and by the backend when run directly with uvicorn.
# Unknown keys make the backend refuse to start (catches typos / retired keys).

# --- Postgres (required) ---
POSTGRES_USER=hcp_user
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=hcp_crm
# Host port for Postgres (bound to 127.0.0.1). If something on your machine
# already listens on 5432 (e.g. a Windows Postgres install), use a free port
# such as 55432. Containers always talk to Postgres on 5432 internally.
POSTGRES_PORT=5432

# --- Groq (required) — create a key at https://console.groq.com/keys ---
GROQ_API_KEY=

# --- Groq models ---
# Main model: the tool-calling agent and next-best-action recommendations.
GROQ_MODEL=openai/gpt-oss-120b
# Fast model: extraction / summarization (turning notes into CRM fields).
GROQ_MODEL_FAST=openai/gpt-oss-20b
# Speech-to-text for voice notes (whisper-large-v3-turbo is faster; whisper-large-v3 is more accurate).
GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo
# The assignment brief's gemma2-9b-it and llama-3.3-70b-versatile are
# decommissioned on Groq; do not use them.

# --- Sign-in (required) ---
# Secret for signing access tokens. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Seed admin, created on startup (and used by migration 008 to own pre-existing rows).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
# Access-token lifetime in minutes (short-lived; reps sign in again after it expires).
# ACCESS_TOKEN_MINUTES=15
# Per-rep limit on AI requests (chat, follow-up suggestions, voice notes) per minute.
# RATE_LIMIT_LLM_PER_MINUTE=20

# --- Optional overrides ---
# Hosted Postgres (Neon, Render, ...): set DATABASE_URL instead of the POSTGRES_* values.
# postgres:// URLs and ?sslmode=require are handled (see docs/DEPLOY.md).
# DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
# Browser origin of the frontend, plus any extra origins (comma-separated).
# FRONTEND_ORIGIN=http://localhost:5173
# CORS_ORIGINS=https://hcp-crm-web.onrender.com,https://crm.example.com
# Apply backend/migrations on startup (idempotent). false = run `python -m app.db_migrations apply` yourself.
# RUN_MIGRATIONS_ON_STARTUP=true
# Host port for the backend (bound to 127.0.0.1):
# BACKEND_PORT=8000

# --- Demo accounts (only for `python -m app.demo_seed`; 12+ characters each) ---
# DEMO_REP_PASSWORD=
# DEMO_MANAGER_PASSWORD=
# DEMO_ADMIN_PASSWORD=
