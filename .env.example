# Used by `docker compose` (copy to .env and fill in; .env is git-ignored).
# For running the backend directly with uvicorn, see backend/.env.example instead.

# --- Postgres (required) ---
POSTGRES_USER=hcp_user
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=hcp_crm
# Host port for Postgres (bound to 127.0.0.1). If something on your machine
# already listens on 5432 (e.g. a Windows Postgres install), use a free port
# such as 55432. Containers always talk to Postgres on 5432 internally.
POSTGRES_PORT=5432

# --- Groq (required) — create a key at https://console.groq.com/keys ---
GROQ_API_KEY=

# --- Groq models ---
# Main model: the tool-calling agent and next-best-action recommendations.
GROQ_MODEL=openai/gpt-oss-120b
# Fast model: extraction / summarization (turning notes into CRM fields).
GROQ_MODEL_FAST=openai/gpt-oss-20b
# The assignment brief's gemma2-9b-it and llama-3.3-70b-versatile are
# decommissioned on Groq; do not use them.

# --- Optional overrides ---
# FRONTEND_ORIGIN=http://localhost:5173
# Host port for the backend (bound to 127.0.0.1):
# BACKEND_PORT=8000
