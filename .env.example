# Used by `docker compose` (copy to .env and fill in; .env is git-ignored).
# For running the backend directly with uvicorn, see backend/.env.example instead.

# --- Postgres (required) ---
POSTGRES_USER=hcp_user
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=hcp_crm

# --- Groq (required) — create a key at https://console.groq.com/keys ---
GROQ_API_KEY=

# --- Optional overrides ---
# GROQ_MODEL=gemma2-9b-it
# GROQ_FALLBACK_MODEL=llama-3.3-70b-versatile
# FRONTEND_ORIGIN=http://localhost:5173
# Host ports (always bound to 127.0.0.1):
# POSTGRES_PORT=5432
# BACKEND_PORT=8000
